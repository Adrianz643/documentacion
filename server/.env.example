PORT=3050
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=gdprod
DB_CONNECTION_LIMIT=10

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Clave AES-256 (64 caracteres hex = 32 bytes) para cifrar la contraseña de la FIEL en BD.
# Generar una por entorno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIEL_CONTRASENA_KEY=

CORS_ORIGIN=http://localhost:4200

# Ruta absoluta al build de Angular (carpeta con index.html) en el servidor de destino.
# Si se omite, se usa ../../dist/gestion-documental-hegewisch/browser relativo a este proyecto.
# ANGULAR_DIST_PATH=/home/usuario/public_html/dist/gestion-documental-hegewisch/browser
